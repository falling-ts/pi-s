#!/usr/bin/env bash
# pi - run upstream pi from source (pi-s local launcher)
#
# Git Bash / MSYS variant of pi.cmd. Note that bash does not search the current
# directory, so run it as ./pi unless "." is on PATH.
set -euo pipefail

self="${BASH_SOURCE[0]}"
# `pwd -W` 是 MSYS/Git Bash 专有选项（返回 Windows 风格路径），Linux 上不支持；
# 有 -W 时沿用（保持与 pi.cmd 的调用方式一致），否则退回 POSIX 的 -P。
if (pwd -W >/dev/null 2>&1); then
	here="$(cd "${self%/*}" && pwd -W)"
else
	here="$(cd "${self%/*}" && pwd -P)"
fi
pi_root="$here/.agents/scratch/pi"
resolver="$pi_root/packages/coding-agent/src/experimental/source-resolver.ts"
cli="$pi_root/packages/coding-agent/src/cli.ts"

if [ ! -f "$cli" ]; then
	echo "pi: local checkout not found: $cli" >&2
	echo 'pi: provision it first - see "Local pi command" in README.md' >&2
	exit 1
fi

exec node --import "file:///$resolver" "$cli" "$@"
